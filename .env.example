# ── 基础 ────────────────────────────────────────────────
OPENCS_ENV=development
OPENCS_DATA_DIR=./data
OPENCS_KNOWLEDGE_DIR=./knowledge
OPENCS_SKILLS_DIR=./skills
OPENCS_TENANT_ID=default
OPENCS_HOST=0.0.0.0
OPENCS_PORT=8080

# ── LLM：三选一；均不配置时自动降级为离线确定性 mock ──
# 生产环境不允许降级，必须配置其一，否则启动失败
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENCS_MODEL=deepseek-chat

# ── 治理 ────────────────────────────────────────────────
# 管理 API / 控制台的访问凭证。生产必填，≥16 字节。
# 客户侧生成：openssl rand -hex 24
OPENCS_ADMIN_TOKEN=
# 生产必填，≥32 字节
OPENCS_ACTION_TOKEN_SECRET=
# 自动放行的风险档。默认 0,1,2,3 —— channel.reply(ORANGE_C) 需人工确认。
# 改成 0,1,2,3,4 让 agent 自动回复客户：这是运营决策，请确认知识库质量后再开。
OPENCS_AUTO_APPROVE_TIERS=0,1,2,3
# 公网 webhook 每会话每分钟消息上限（防刷 LLM 账单）
OPENCS_WEBHOOK_RATE_LIMIT=20

# ── 节奏引擎 ────────────────────────────────────────────
OPENCS_NURTURE_ENABLED=true
OPENCS_NURTURE_POLL_INTERVAL=60
# 不要设成 1：串行投递会让批处理时长超过租约，触发回收并重复发送
OPENCS_NURTURE_DRAIN_CONCURRENCY=8
# 按「单条耗时 × 批大小 ÷ 并发度 × 安全系数」推算。
# LLM 组稿约 40s/条，批 50、并发 8 → 40×50÷8×1.2 ≈ 300
OPENCS_NURTURE_LEASE_SECONDS=300

# ── 企业微信客服（可选，四件套必须同时配置） ────────────
# 企业 ID（我的企业 → 企业信息）
WECOM_CORP_ID=
# 微信客服的 Secret（客服 → API → Secret）
WECOM_CORP_SECRET=
# 回调配置里的 Token 与 43 位 EncodingAESKey
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# 客服账号 id（可选；省略时从首个回调事件里推断）
WECOM_OPEN_KFID=

# ── 观测（可选） ────────────────────────────────────────
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
